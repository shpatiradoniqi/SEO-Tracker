{
  "name": "seo-tracker",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "db:migrate": "npm run migrate -w @seo/api",
    "seed": "npm run seed -w @seo/api",
    "dev": "concurrently -n api,worker,web -c blue,magenta,green \"npm run dev -w @seo/api\" \"npm run dev:worker -w @seo/api\" \"npm run dev -w @seo/web\"",
    "worker": "npm run worker -w @seo/api",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build -w @seo/web"
  },
  "engines": {
    "node": ">=20.12"
  },
  "devDependencies": {
    "concurrently": "10.0.6"
  }
}

# Copy to .env (same values work with docker-compose.yml)
DATABASE_URL=postgres://seo:seo@localhost:5432/seo_tracker
# Host port docker-compose publishes Postgres on. If 5432 is taken (e.g. a local
# PostgreSQL install), set e.g. 5433 here and use the same port in DATABASE_URL.
DB_PORT=5432
API_PORT=3001
# Crawl jobs each worker process runs at once (npm run worker)
WORKER_CONCURRENCY=2
# The crawler honours robots.txt Crawl-delay (www.semrush.com asks for 20 s, so seeding takes ~6+ min).
# Uncomment to cap it, e.g. for demos: CRAWL_DELAY_MAX_SECONDS=2
# CRAWL_DELAY_MAX_SECONDS=

# Optional: let Claude pick each page's final keywords from the heuristic's top 12 (one request per crawl).
# Off unless set to "claude". Needs ANTHROPIC_API_KEY (or another Anthropic SDK credential source).
# KEYWORD_RERANK=claude
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
# Long random string, required. Keys the per-session CSRF tokens; keep it private in real deployments
SESSION_SECRET=change-me
# Set to "true" only when running the API behind HTTPS
COOKIE_SECURE=false
# Set to "true" behind a reverse proxy so login rate limiting sees the real client IP
TRUST_PROXY=false
